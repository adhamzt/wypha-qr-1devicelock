{
  "name": "wypha-microsite-v43",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
  // Opsional: Untuk mengaktifkan penyimpanan permanen Cloudflare R2,
  // buat bucket R2 bernama "wypha-media" di dashboard Cloudflare lalu hapus tanda // di bawah ini:
  // ,"r2_buckets": [
  //   {
  //     "binding": "WYPHA_MEDIA_BUCKET",
  //     "bucket_name": "wypha-media"
  //   }
  // ]
}
